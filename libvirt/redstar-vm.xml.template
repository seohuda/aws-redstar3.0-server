<domain type='kvm'>
  <name>redstar-server</name>
  <uuid>4b3a165b-76b1-4f76-88e8-971c2602e1a3</uuid>
  <memory unit='KiB'>2097152</memory>
  <currentMemory unit='KiB'>2097152</currentMemory>
  <vcpu placement='static'>2</vcpu>
  <os>
    <type arch='x86_64' machine='pc-q35-8.2'>hvm</type>
    <boot dev='cdrom'/>
    <boot dev='hd'/>
    <bootmenu enable='yes'/>
  </os>
  <features>
    <acpi/>
    <apic/>
    <pae/>
  </features>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>restart</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <!-- Primary OS Hard Disk -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='/var/lib/libvirt/images/redstar-server.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <!-- CD-ROM Drive (Swappable between boot and install ISOs) -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/images/redstar-boot.iso'/>
      <target dev='hdc' bus='ide'/>
      <readonly/>
    </disk>
    <!-- Network Interface (e1000 for legacy Red Star kernel 2.6.38 compatibility) -->
    <interface type='network'>
      <source network='default'/>
      <model type='e1000'/>
    </interface>
    <input type='tablet' bus='usb'/>
    <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/>
    <!-- Graphics: VNC listening on localhost for SSH tunnel tunneling -->
    <graphics type='vnc' port='5900' autoport='no' listen='127.0.0.1'>
      <listen type='address' address='127.0.0.1'/>
    </graphics>
    <video>
      <model type='vga' vram='16384' heads='1'/>
    </video>
  </devices>
</domain>
